           </widget>
          </item>
          <item row="4" column="1">
           <widget class="QPlainTextEdit" name="kcfg_floatConfig">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;One rule per line. Format:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt; font-weight:700;&quot;&gt;&amp;lt;ClassName&amp;gt;[,&amp;lt;ClassName&amp;gt;...][:&amp;lt;Title&amp;gt;]:&amp;lt;param&amp;gt;=&amp;lt;value&amp;gt;[,&amp;lt;param&amp;gt;=&amp;lt;value&amp;gt;...]&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;Wrap title in [brackets] for substring match, e.g. [Firefox] matches &amp;quot;Mozilla Firefox&amp;quot;.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;Without brackets the title is matched exactly.&lt;br/&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;Examples:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;Make Krohnkite settings float:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt; font-weight:700;&quot;&gt;systemsettings:Configure — System Settings:auto=1&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;Windows with windowClass &lt;/span&gt;&lt;span style=&quot; font-size:10pt; font-weight:700;&quot;&gt;konsole,kate &lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;will always be floating with init size width/height=60% of init screen and with left indent 120 pixel and top indent 10% of init screen height. &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt; font-weight:700;&quot;&gt;konsole,kate:width=60,height=60,li=120px,ti=10%&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;Windows with windowClass 'firefox' and title contain 'Firefox' word will have width: 60%,height: native and will float when open by could be tile later.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt; font-weight:700;&quot;&gt;firefox:[Firefox]:w=60,f=false,auto=true&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;window with any class and 'gimp' title will have shoudFloat=true&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt; font-weight:700;&quot;&gt;:gimp: (all defaults) &lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;&lt;br/&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;Params could be omit:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;shoudFloat, f — makes window float forever. true or false (default: true)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;auto, a — open window float. true or false (default:  'by default all new windows become floating' flag value )&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;width, w — 1-100 percent of screen (default: inherit global)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;height, h — 1-100 percent of screen (default: inherit global)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;leftIndent, left, li — offset from left in px (default) or % (e.g. 100, 50px, 20%). Default: inherit native&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;topIndent, top, ti — offset from top in px (default) or % (e.g. 100, 50px, 20%). Default: inherit native&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;stepWidth, sw — 0-100 percent of screen width by which the floating window move,expands/contracts per resize/move shortcut press (default: inherit global)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;stepHeight, sh — 0-100 percent of screen height by which the floating window move,expands/contracts per resize/move shortcut press (default: inherit global)&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
