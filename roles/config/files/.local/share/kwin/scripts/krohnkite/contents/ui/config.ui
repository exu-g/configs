             <string>Sequence time</string>
            </property>
           </widget>
          </item>
          <item row="1" column="3">
           <spacer name="horizontalSpacer_23">
            <property name="orientation">
             <enum>Qt::Orientation::Horizontal</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>40</width>
              <height>20</height>
             </size>
            </property>
           </spacer>
          </item>
          <item row="1" column="4">
           <widget class="QToolButton" name="toolButton">
            <property name="contextMenuPolicy">
             <enum>Qt::ContextMenuPolicy::NoContextMenu</enum>
            </property>
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;One rule per line. Case insensitive. Format:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt; font-weight:700;&quot;&gt;&amp;lt;Shortcut&amp;gt;[,&amp;lt;Shortcut&amp;gt;...]:&amp;lt;flag&amp;gt;=&amp;lt;value&amp;gt;[,&amp;lt;flag&amp;gt;=&amp;lt;value&amp;gt;...]&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;A comma-separated list of shortcuts forms a key sequence that must be pressed in order. Shortcut and action names are listed above in &amp;quot;Possible shortcuts and actions&amp;quot;.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;Flags (at least one action flag is required):&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt; font-weight:700;&quot;&gt;mainaction|ma&lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt; — the action to perform (KrohnkiteAction).&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt; font-weight:700;&quot;&gt;registeraction|ra&lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt; — the action to perform while the register (meta) mode is active (KrohnkiteAction).&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt; font-weight:700;&quot;&gt;sequencetime|st&lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt; — milliseconds, overrides the &amp;quot;Sequence time&amp;quot; setting for that rule.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;Examples:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt; font-weight:700;&quot;&gt;MoveLeftSC:ra=swapleft&lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt; — assign SwapLeft action to MoveLeftSC shortcut when register is on. &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:10pt; font-weight:700;&quot;&gt;GrowWidthSC,ShrinkWidthSC:ma=resetSurfaceCapacity,st=500&lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt; — assign shortcut sequence with sequence time overriding to 500 ml with main action to reset srf capacity.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>?</string>
            </property>
            <property name="icon">
             <iconset theme="dialog-question"/>
            </property>
            <property name="iconSize">
             <size>
              <width>32</width>
              <height>32</height>
             </size>
            </property>
            <property name="popupMode">
             <enum>QToolButton::ToolButtonPopupMode::InstantPopup</enum>
            </property>
            <property name="toolButtonStyle">
             <enum>Qt::ToolButtonStyle::ToolButtonIconOnly</enum>
            </property>
           </widget>
          </item>
