             </sizepolicy>
            </property>
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Double push AlterRegisterSC to toggle on/off  the Register.&lt;/p&gt;&lt;p&gt;add shortcut sequence:&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;AlterRegisterSC,AlterRegisterSC:ma=ToggleRegister,ra=ToggleRegister&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
